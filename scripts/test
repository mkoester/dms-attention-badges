#!/usr/bin/env node
// Unit tests for Rules.js — the provider format and the parsing/state logic
// behind the badges.
//
// The notification fixtures below are SHAPE-FAITHFUL copies of real entries taken
// from ~/.cache/DankMaterialShell/notification_history.json (only the mail
// addresses were replaced, since this repo may go public). That matters: a tidy
// invented fixture would pass whatever the regex does, and the whole risk here is
// that Thunderbird's real wording differs from what we remember it being.
//
// The providers themselves live in their own repos and are tested there; this
// suite covers the host, using inline fixtures of each provider kind.

const R = require("../Rules.js");

let failed = 0;
let ran = 0;

function check(name, actual, expected) {
    ran++;
    const a = JSON.stringify(actual);
    const e = JSON.stringify(expected);
    if (a !== e) {
        failed++;
        console.error(`FAIL  ${name}\n        expected ${e}\n        actual   ${a}`);
    }
}

function ok(name, cond) {
    check(name, !!cond, true);
}


// ── Path expansion ──────────────────────────────────────────────────────────
// A provider file must never carry an absolute home path, so the core expands
// the handful of variables it is allowed to use. Tested against an explicit env
// so it does not depend on the machine running the suite.
const ENV = { HOME: "/home/tester" };
check("~ expands", R.expandPath("~/x", ENV), "/home/tester/x");
check("$HOME expands", R.expandPath("$HOME/x", ENV), "/home/tester/x");
check("${HOME} expands", R.expandPath("${HOME}/x", ENV), "/home/tester/x");
check("XDG_STATE_HOME defaults per spec", R.expandPath("$XDG_STATE_HOME/x", ENV), "/home/tester/.local/state/x");
check("an explicit XDG_STATE_HOME wins", R.expandPath("$XDG_STATE_HOME/x", { HOME: "/h", XDG_STATE_HOME: "/state" }), "/state/x");
check("XDG_CONFIG_HOME defaults per spec", R.expandPath("$XDG_CONFIG_HOME/x", ENV), "/home/tester/.config/x");
check("an absolute path is untouched", R.expandPath("/etc/x", ENV), "/etc/x");
check("an empty path stays empty", R.expandPath("", ENV), "");
// A tilde only counts at the start — "a~/b" is a filename, not a home reference.
check("a mid-string tilde is not expanded", R.expandPath("/a~/b", ENV), "/a~/b");

// $PROVIDER_DIR is what makes a provider a self-contained clone: a helper script
// beside provider.json is addressable with no symlink and no dependence on PATH,
// which the shell's systemd unit does not extend to ~/.local/bin.
const PENV = { HOME: "/home/tester", PROVIDER_DIR: "/home/tester/.config/DankMaterialShell/attention-providers/herdr" };
check("$PROVIDER_DIR expands", R.expandPath("$PROVIDER_DIR/herdr-attention", PENV),
    "/home/tester/.config/DankMaterialShell/attention-providers/herdr/herdr-attention");
check("${PROVIDER_DIR} expands", R.expandPath("${PROVIDER_DIR}/x", PENV),
    "/home/tester/.config/DankMaterialShell/attention-providers/herdr/x");
// No default, deliberately: a flat provider using it must produce a path that
// cannot resolve, so it fails loudly at spawn rather than quietly finding some
// other binary of the same name that happens to be on PATH.
check("$PROVIDER_DIR has no default", R.expandPath("$PROVIDER_DIR/x", ENV), "/x");
// $HOME must not eat the tail of the other variable names.
check("$XDG_STATE_HOME is not mangled by $HOME", R.expandPath("$XDG_STATE_HOME", ENV), "/home/tester/.local/state");

// ── Representative providers of each kind ───────────────────────────────────
// Inline, not loaded from disk: the real provider files now live in their own
// repos (dms-attention-badges-tb, dms-attention-badges-herdr) and are tested
// there. Keeping copies here would give one provider two sources that drift.
const tbFile = {
    id: "thunderbird",
    label: "Thunderbird",
    icon: "mail",
    source: {
        kind: "notifications",
        desktopEntry: "org.mozilla.Thunderbird",
        bucket: {
            source: "summary",
            pattern: "^(\\S+@\\S+) received (\\d+) new messages?$",
            nameGroup: 1,
            countGroup: 2
        },
        fallbackBucket: "other"
    },
    reset: {
        kind: "windowFocus",
        windowClass: "org.mozilla.Thunderbird",
        perBucketFile: "$XDG_STATE_HOME/thunderbird-attention-bridge/visits.json"
    }
};
const herdrFile = {
    id: "herdr",
    label: "herdr",
    icon: "terminal",
    source: {
        kind: "command",
        command: ["$PROVIDER_DIR/herdr-attention", "--statuses", "blocked,done"],
        intervalSeconds: 3,
        mode: "state"
    }
};

const tbParsed = R.parseProvider(tbFile);
check("the Thunderbird provider parses", tbParsed.errors, []);
const herdrParsed = R.parseProvider(herdrFile);
check("the herdr provider parses", herdrParsed.errors, []);

const tb = tbParsed.target;
const herdr = herdrParsed.target;

check("a notifications source counts", tb.mode, "count");
check("a command source defaults to state", herdr.mode, "state");
check("the provider keeps its window class", tb.windowClass, "org.mozilla.Thunderbird");
check("the provider declares a per-bucket file", typeof tb.perBucketFile, "string");
check("...which is not an absolute home path", tb.perBucketFile.indexOf("/home/"), -1);
check("a state target has no window class", herdr.windowClass, undefined);
check("the herdr provider polls every 3s", herdr.intervalSeconds, 3);

// ── Provider validation ─────────────────────────────────────────────────────
// Every rejection must name its reason: a provider that fails to load is shown
// in the settings page, and "invalid" with no explanation is unactionable.
function errorsFor(data) {
    return R.parseProvider(data).errors;
}
function rejects(name, data, fragment) {
    const errs = errorsFor(data);
    ran++;
    const hit = errs.some(function (e) { return e.indexOf(fragment) !== -1; });
    if (!hit) {
        failed++;
        console.error(`FAIL  ${name}\n        expected an error containing ${JSON.stringify(fragment)}\n        actual   ${JSON.stringify(errs)}`);
    }
}

const minimal = { id: "x", source: { kind: "notifications", appName: "X" } };
check("a minimal provider is valid", errorsFor(minimal), []);
check("label defaults to the id", R.parseProvider(minimal).target.label, "x");
check("icon has a neutral default", R.parseProvider(minimal).target.icon, "notifications");

rejects("no id", { source: { kind: "notifications", appName: "X" } }, "id must match");
rejects("a dashed id", { id: "my-app", source: { kind: "notifications", appName: "X" } }, "id must match");
rejects("an id starting uppercase", { id: "App", source: { kind: "notifications", appName: "X" } }, "id must match");
rejects("no source", { id: "x" }, "missing source object");
rejects("an unknown kind", { id: "x", source: { kind: "dbus" } }, "source.kind must be one of");
rejects("notifications with no criteria", { id: "x", source: { kind: "notifications" } }, "at least one of");
rejects("a bad summary regex", { id: "x", source: { kind: "notifications", summaryPattern: "([" } }, "summaryPattern is not a valid regex");
rejects("a bad bucket regex", { id: "x", source: { kind: "notifications", appName: "X", bucket: { pattern: "([" } } }, "bucket.pattern is not a valid regex");
rejects("a bucket with no pattern", { id: "x", source: { kind: "notifications", appName: "X", bucket: {} } }, "bucket.pattern is not a valid regex");
rejects("a command that is not a list", { id: "x", source: { kind: "command", command: "herdr" } }, "non-empty array of strings");
rejects("an empty command", { id: "x", source: { kind: "command", command: [] } }, "non-empty array of strings");
rejects("a reset on a state target", { id: "x", source: { kind: "command", command: ["y"] }, reset: { kind: "windowFocus", windowClass: "y" } }, "state target takes no reset");
rejects("an unknown reset kind", { id: "x", source: { kind: "notifications", appName: "X" }, reset: { kind: "timer" } }, "reset.kind must be");
rejects("a reset with no window class", { id: "x", source: { kind: "notifications", appName: "X" }, reset: { kind: "windowFocus" } }, "reset.windowClass is required");
rejects("a non-object", "hello", "not a JSON object");

// A rejected provider must yield NO target — a half-built one whose match rules
// failed to apply would swallow every notification on the system.
check("a rejected provider yields no target", R.parseProvider({ id: "x", source: { kind: "notifications" } }).target, null);

// A command target may opt into counting; the default is state, and the two must
// be distinguishable or the mode setting would be untestable.
check("a command target can count", R.parseProvider({ id: "x", source: { kind: "command", command: ["y"], mode: "count" } }).target.mode, "count");
check("an unknown mode falls back to state", R.parseProvider({ id: "x", source: { kind: "command", command: ["y"], mode: "wat" } }).target.mode, "state");
check("intervalSeconds has a default", R.parseProvider({ id: "x", source: { kind: "command", command: ["y"] } }).target.intervalSeconds, 5);
check("a sub-second interval is refused, not honoured", R.parseProvider({ id: "x", source: { kind: "command", command: ["y"], intervalSeconds: 0 } }).target.intervalSeconds, 5);

// ── buildTargets ────────────────────────────────────────────────────────────
const built = R.buildTargets([
    { source: "thunderbird.json", data: tbFile },
    { source: "herdr.json", data: herdrFile }
]);
check("both providers build", built.targets.map(t => t.id), ["thunderbird", "herdr"]);
check("nothing invalid", built.invalid, []);
check("each target remembers its file", built.targets[0].source, "thunderbird.json");

const withJunk = R.buildTargets([
    { source: "good.json", data: minimal },
    { source: "broken.json", data: { id: "y" } }
]);
check("a broken file does not stop the good ones", withJunk.targets.map(t => t.id), ["x"]);
check("...and is reported with its filename", withJunk.invalid[0].source, "broken.json");
ok("...and with a reason", withJunk.invalid[0].errors.length > 0);

const dupes = R.buildTargets([
    { source: "user.json", data: minimal },
    { source: "shipped.json", data: minimal }
]);
check("a duplicate id is refused", dupes.targets.length, 1);
check("...the first one wins", dupes.invalid[0].source, "shipped.json");
ok("...and the winner is named in the error", dupes.invalid[0].errors[0].indexOf("user.json") !== -1);

check("no files means no targets, not a crash", R.buildTargets([]), { targets: [], invalid: [] });
check("undefined input does not throw", R.buildTargets(undefined), { targets: [], invalid: [] });

// A directory provider carries the directory it was read from, so $PROVIDER_DIR
// can resolve. A flat file has none — that is what makes the no-default above
// the safe choice rather than an oversight.
const dirBuilt = R.buildTargets([
    { source: "herdr/provider.json", dir: "/p/herdr", data: herdrFile },
    { source: "thunderbird.json", data: tbFile }
]);
check("a directory provider records its directory", dirBuilt.targets[0].dir, "/p/herdr");
check("a flat provider records none", dirBuilt.targets[1].dir, "");
check("the recorded directory resolves the command", R.expandPath(dirBuilt.targets[0].command[0], { HOME: "/h", PROVIDER_DIR: dirBuilt.targets[0].dir }), "/p/herdr/herdr-attention");

// Two clones both called provider.json must not collide. The daemon keys by the
// source PATH for exactly this reason; if it keyed by filename these would be
// one entry and the second provider would vanish with no error anywhere.
const twoClones = R.buildTargets([
    { source: "herdr/provider.json", dir: "/p/herdr", data: herdrFile },
    { source: "thunderbird/provider.json", dir: "/p/thunderbird", data: tbFile }
]);
check("two directory providers both build", twoClones.targets.map(t => t.id), ["herdr", "thunderbird"]);
check("...with their own directories", twoClones.targets.map(t => t.dir), ["/p/herdr", "/p/thunderbird"]);

// ── The command stdout contract ─────────────────────────────────────────────
// Every failure must be distinguishable from an empty-but-valid result, because
// they render identically in the bar.
check("a valid payload parses", R.parseCommandOutput('{"buckets":{"a":2,"b":1}}'), { buckets: { a: 2, b: 1 }, error: null });
check("an empty bucket set is valid, not an error", R.parseCommandOutput('{"buckets":{}}'), { buckets: {}, error: null });
check("no output is an error", R.parseCommandOutput("").error, "no output");
check("whitespace only is an error", R.parseCommandOutput("  \n ").error, "no output");
ok("non-JSON says so", R.parseCommandOutput("herdr: command not found").error.indexOf("not JSON") === 0);
ok("a bare array is rejected", R.parseCommandOutput("[1,2]").error.indexOf("not an object") !== -1);
ok("a missing buckets key says so", R.parseCommandOutput('{"agents":[]}').error.indexOf('missing "buckets"') !== -1);
check("counts are floored to integers", R.parseCommandOutput('{"buckets":{"a":2.7}}').buckets, { a: 2 });
check("a zero count is dropped", R.parseCommandOutput('{"buckets":{"a":0,"b":1}}').buckets, { b: 1 });
ok("...and the drop is reported, not silent", R.parseCommandOutput('{"buckets":{"a":0,"b":1}}').error !== null);
check("a non-numeric count is dropped", R.parseCommandOutput('{"buckets":{"a":"lots"}}').buckets, {});

function notif(o) {
    return Object.assign(
        { appName: "", desktopEntry: "", summary: "", body: "", timestamp: 1000 },
        o
    );
}

// ── Thunderbird: the real notification shape ────────────────────────────────
const mailSingle = notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "mk@example.de received 1 new message",
    body: "Your invoice is ready from Example GmbH"
});
const mailPlural = notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "other@example.com received 2 new messages",
    body: "Some subject from Some Sender"
});
// Real entry: Thunderbird also emits non-mail notifications on the same app id.
// Confirmed still true 2026-08-15 against a live history file, where the one
// non-mail entry was "Failed to connect to server …".
const mailError = notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "Thunderbird",
    body: "Failed to connect to server archive.mail.example.de."
});

check("tb matches its own notification", R.matches(tb, mailSingle), true);
check("tb ignores a foreign notification", R.matches(tb, notif({ desktopEntry: "brave-browser" })), false);
check("singular parses", R.parse(tb, mailSingle), { bucket: "mk@example.de", count: 1 });
check("plural parses with its count", R.parse(tb, mailPlural), { bucket: "other@example.com", count: 2 });
check("non-mail falls back, is not dropped", R.parse(tb, mailError), { bucket: "other", count: 1 });

// A locale change is the most likely way this breaks. It must degrade to the
// fallback bucket (visible) rather than to silence.
const mailGerman = notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "mk@example.de hat 2 neue Nachrichten erhalten"
});
check("unparseable summary is still counted", R.parse(tb, mailGerman), { bucket: "other", count: 1 });

// ── State targets are not fed by notifications ──────────────────────────────
// Window focus cannot mean "I dealt with that pane" for an app you sit inside,
// so a state target must not be counted from the notification stream at all.
const attention = notif({ appName: "notify-send", summary: "claude needs attention", body: "homelab · 3 · claude" });

check("herdr is state-mode", herdr.mode, "state");
check("a state target ignores notifications", R.matches(herdr, attention), false);

// ── A state target's buckets come from its command, not from here ──────────
// The herdr extraction that used to live in this repo moved to
// dms-attention-badges-herdr and is tested there. What the core must still
// guarantee is that a state target is never fed by the notification stream.

// ── Folding history ─────────────────────────────────────────────────────────
const T = [tb, herdr];

// Newest-first, exactly as DMS stores it, with one entry already seen.
const history = [
    Object.assign({}, mailPlural, { timestamp: 5000 }),
    Object.assign({}, attention, { timestamp: 4000 }),
    Object.assign({}, mailSingle, { timestamp: 3000 }),
    Object.assign({}, mailSingle, { timestamp: 1000 })
];

let s = R.applyHistory({ lastSeenTs: 2000, targets: {} }, T, history);
check("counts only entries newer than lastSeenTs", R.totalFor(s, "thunderbird"), 3);
check("lastSeenTs advances to the newest entry", s.lastSeenTs, 5000);
check("per-account buckets", R.bucketList(s, "thunderbird"), [
    { name: "other@example.com", count: 2 },
    { name: "mk@example.de", count: 1 }
]);
check("a state target is not fed by the notification stream", R.totalFor(s, "herdr"), 0);

// Give herdr some state so the isolation check below has something to preserve.
s = R.setTargetBuckets(s, "herdr", { "homelab · 3 · claude": 1 });

// Re-folding the same history must be a no-op — the daemon re-reads historyList
// on every change, including dismissals and prunes.
const again = R.applyHistory(s, T, history);
check("re-folding the same history changes nothing", again, s);

// applyHistory must not mutate its input.
const before = { lastSeenTs: 0, targets: {} };
R.applyHistory(before, T, history);
check("input state is not mutated", before, { lastSeenTs: 0, targets: {} });

// ── Resets ──────────────────────────────────────────────────────────────────
check("focusing thunderbird clears only it", R.totalFor(R.clearTarget(s, "thunderbird"), "thunderbird"), 0);
check("...and leaves herdr alone", R.totalFor(R.clearTarget(s, "thunderbird"), "herdr"), 1);
check("clearing one bucket leaves the rest", R.totalFor(R.clearBucket(s, "thunderbird", "other@example.com"), "thunderbird"), 1);
check("clearing the last bucket drops the target", R.clearBucket(s, "herdr", "homelab · 3 · claude").targets.herdr, undefined);
check("a cleared target reports zero, not NaN", R.totalFor(R.emptyState(), "thunderbird"), 0);

// ── Orphan pruning ──────────────────────────────────────────────────────────
// Deleting a provider file must not leave its counts in the persisted state,
// where they are invisible but return the moment the id reappears.
const orphaned = R.setTargetBuckets(s, "gone", { x: 3 });
check("state for a removed provider is dropped", R.pruneOrphans(orphaned, T).targets.gone, undefined);
check("...and live providers survive", R.totalFor(R.pruneOrphans(orphaned, T), "thunderbird"), 3);
check("pruning with nothing to prune returns the same object", R.pruneOrphans(s, T), s);
check("pruning against no targets empties it", R.pruneOrphans(s, []).targets, {});

// ── Per-bucket resets ───────────────────────────────────────────────────────
// Without the helper file, focusing the app clears every bucket (clearTarget).
// With it, only the buckets you actually opened clear.
const now = Date.now();
let bs = R.emptyState();
bs = R.applyHistory(bs, T, [
    Object.assign({}, mailSingle, { timestamp: 100 }),   // mk@example.de
    Object.assign({}, mailPlural, { timestamp: 200 })    // other@example.com
]);
check("two accounts pending before any visit", R.totalFor(bs, "thunderbird"), 3);

const visited = { version: 1, updatedAt: now, visits: { "mk@example.de": now } };
check("a fresh bridge file is live", R.bridgeIsLive(visited, now), true);
check("no file is not live", R.bridgeIsLive(null, now), false);
check("a file with no visits key is not live", R.bridgeIsLive({ updatedAt: now }, now), false);
check("an abandoned file stops being live", R.bridgeIsLive(visited, now + 8 * 24 * 3600 * 1000), false);

bs = R.applyVisits(bs, "thunderbird", visited);
check("the visited account clears", R.bucketList(bs, "thunderbird"), [{ name: "other@example.com", count: 2 }]);

// Re-reading the same file must not re-clear: the file is re-read on every write
// and once at startup, and mail arriving after a visit has to survive that.
bs = R.applyEntry(bs, T, notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "mk@example.de received 1 new message",
    timestamp: 300
}));
check("new mail for a visited account counts again", R.totalFor(bs, "thunderbird"), 3);
bs = R.applyVisits(bs, "thunderbird", visited);
check("re-reading an unchanged visit does not re-clear", R.totalFor(bs, "thunderbird"), 3);

// A later visit does clear it.
bs = R.applyVisits(bs, "thunderbird", { version: 1, updatedAt: now + 1000, visits: { "mk@example.de": now + 1000 } });
check("a NEWER visit clears again", R.bucketList(bs, "thunderbird"), [{ name: "other@example.com", count: 2 }]);

// Thunderbird spells addresses as it likes; the extension lowercases.
let cs = R.applyEntry(R.emptyState(), T, notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "MK@Example.de received 1 new message",
    timestamp: 400
}));
cs = R.applyVisits(cs, "thunderbird", { version: 1, updatedAt: now, visits: { "mk@example.de": now } });
check("bucket matching is case-insensitive", R.totalFor(cs, "thunderbird"), 0);

// visitsSeen must survive ordinary counting, or every notification would make
// the next file read look new and re-clear a bucket that just counted mail.
const carried = R.applyEntry(bs, T, notif({
    appName: "Thunderbird",
    desktopEntry: "org.mozilla.Thunderbird",
    summary: "third@example.com received 1 new message",
    timestamp: 500
}));
check("visitsSeen survives counting", carried.visitsSeen["mk@example.de"], now + 1000);
check("...and survives a focus clear", R.clearTarget(carried, "thunderbird").visitsSeen["mk@example.de"], now + 1000);
check("...and survives an orphan prune", R.pruneOrphans(carried, T).visitsSeen["mk@example.de"], now + 1000);

// ── Window-class lookup (the focus side) ────────────────────────────────────
check("window class maps to its target", R.targetForWindowClass(T, "org.mozilla.Thunderbird").id, "thunderbird");
check("matching is case-insensitive", R.targetForWindowClass(T, "ORG.MOZILLA.THUNDERBIRD").id, "thunderbird");
check("an unwatched class matches nothing", R.targetForWindowClass(T, "firefox"), null);
check("an empty class matches nothing", R.targetForWindowClass(T, ""), null);

console.log(`${ran - failed}/${ran} assertions passed`);
process.exit(failed === 0 ? 0 : 1);
